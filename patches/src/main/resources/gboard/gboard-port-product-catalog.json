{
  "$schema": "gboard-port-product-catalog.schema.json",
  "format": "gboard-port-product-catalog.v1",
  "catalog_version": "1.15.0",
  "composition": {
    "selected_only_call_chain": true,
    "runtime_feature_mask": false
  },
  "binding_contracts": {
    "flag_bool_getter": "method",
    "flag_name_field": "field"
  },
  "anchor_families": [
    "dedicated_bytecode",
    "flag_bool_getter",
    "gesture_dispatch",
    "pointer_lifecycle",
    "resource_only",
    "soft_key_bind"
  ],
  "features": [
    {
      "feature_id": "custom_gallery",
      "public_patch_name": "Custom Gallery for GIFs & Stickers",
      "feature_marker": "dev.jason.gboardpatches.feature.custom_gallery",
      "target_family_ids": [
        "customgallery"
      ],
      "migration_scope": "version-sensitive",
      "consumer_files": [
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/customgallery/GboardCustomGalleryCorpusBytecodePatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/customgallery/GboardCustomGalleryFeatureMarkerPatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/registry/GboardPatchRegistry.kt"
      ],
      "contributions": [
        {
          "contribution_id": "custom_gallery.resources",
          "anchor_family_id": "resource_only",
          "phase": "resource",
          "order": 100,
          "required_bindings": [],
          "runtime_calls": []
        }
      ]
    },
    {
      "feature_id": "pins",
      "public_patch_name": "Pins (Pinterest)",
      "feature_marker": "dev.jason.gboardpatches.feature.pins",
      "target_family_ids": [
        "pins"
      ],
      "migration_scope": "version-sensitive",
      "consumer_files": [
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/pins/GboardPinsCorpusBytecodePatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/pins/GboardPinsFeatureMarkerPatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/registry/GboardPatchRegistry.kt"
      ],
      "contributions": [
        {
          "contribution_id": "pins.resources",
          "anchor_family_id": "resource_only",
          "phase": "resource",
          "order": 110,
          "required_bindings": [],
          "runtime_calls": []
        }
      ]
    },
    {
      "feature_id": "recent_images_limit",
      "public_patch_name": "Recent Stickers & GIFs Limit",
      "feature_marker": "dev.jason.gboardpatches.feature.recent_images_limit",
      "target_family_ids": [
        "recentimageslimit",
        "flag.reader"
      ],
      "migration_scope": "version-sensitive",
      "consumer_files": [
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/recentimageslimit/GboardRecentImagesLimitBytecodePatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/recentimageslimit/GboardRecentImagesLimitFeatureMarkerPatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/features/recentimageslimit/GboardRecentImagesLimitFlagValuePatch.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/registry/GboardPatchRegistry.kt",
        "patches/src/main/kotlin/dev/jason/gboardpatches/patches/gboard/shared/GboardFlagFamilyComposer.kt"
      ],
      "contributions": [
        {
          "contribution_id": "recent_images_limit.flag",
          "anchor_family_id": "flag_bool_getter",
          "phase": "after_stock_result",
          "order": 550,
          "required_bindings": [
            "flag_bool_getter",
            "flag_name_field"
          ],
          "runtime_calls": [
            "RECENT_IMAGES_LIMIT_RUNTIME_APPLY_OVERRIDDEN_FLAG_VALUE"
          ]
        }
      ]
    }
